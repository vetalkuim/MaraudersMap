<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/background_title"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/background_plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/parchment"
                android:text="@string/background_plain"
                android:textColor="@color/parchment" />

            <RadioButton
                android:id="@+id/background_dust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/parchment"
                android:text="@string/background_dust"
                android:textColor="@color/parchment" />
        </RadioGroup>

        <TextView
            android:id="@+id/map_intensity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/map_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="@color/parchment"
            android:thumbTint="@color/parchment" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/inscriptions_title"
            android:textColor="@color/parchment"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/inscription_title_label"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/title_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <RadioGroup
            android:id="@+id/title_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/inscription_dedication_label"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/dedication_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <RadioGroup
            android:id="@+id/dedication_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/creatures_title"
            android:textColor="@color/parchment"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dementor_count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/dementor_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="@color/parchment"
            android:thumbTint="@color/parchment" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/travelers_title"
            android:textColor="@color/parchment"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/travelers_hint"
            android:textColor="@color/parchment_dark"
            android:textSize="14sp" />

        <Button
            android:id="@+id/add_traveler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/parchment"
            android:text="@string/add_traveler"
            android:textColor="@color/ink" />

        <LinearLayout
            android:id="@+id/traveler_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/set_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/parchment_dark"
            android:text="@string/set_wallpaper"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
